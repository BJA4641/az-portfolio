# Copy to .env and fill in for local development.
#
# If your Postgres provider gives you a pooled connection string (e.g.
# Supabase's transaction pooler, port 6543), set DATABASE_URL to that one
# and DIRECT_URL to the direct (non-pooled) connection string, port 5432 —
# Prisma needs the direct one to run migrations. For a plain local Postgres
# with no pooler, set both to the same value.
DATABASE_URL="postgresql://user:password@localhost:5432/az_portfolio"
DIRECT_URL="postgresql://user:password@localhost:5432/az_portfolio"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"

# Used only by prisma/seed.ts to create the first owner login.
SEED_OWNER_EMAIL="owner@example.com"
SEED_OWNER_PASSWORD="change-me-now"

# Optional. Enables "Auto-fetch live comps" on the market analysis page,
# via RentCast (https://www.rentcast.io/api, US properties only). Leave
# unset to keep that button disabled with an explanatory tooltip.
RENTCAST_API_KEY=""
