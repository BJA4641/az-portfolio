# Copy to .env and fill in for local development.
# In Vercel, connect Storage > Postgres from the dashboard and it injects
# DATABASE_URL automatically — no need to set it manually there.
DATABASE_URL="postgresql://user:password@localhost:5432/az_portfolio"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"

# Used only by prisma/seed.ts to create the first owner login.
SEED_OWNER_EMAIL="owner@example.com"
SEED_OWNER_PASSWORD="change-me-now"
