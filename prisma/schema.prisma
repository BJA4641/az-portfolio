generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  OWNER
  STAFF
  TENANT
}

enum PropertyType {
  HOUSE
  APARTMENT
  COMMERCIAL
  LAND
  OTHER
}

enum PropertyStatus {
  OWNED
  FOR_SALE
  SOLD
}

enum LeaseFrequency {
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum LeaseStatus {
  ACTIVE
  EXPIRED
  TERMINATED
}

enum PaymentStatus {
  PENDING
  PAID
  LATE
  MISSED
}

enum TaxStatus {
  PENDING
  PAID
  OVERDUE
}

enum SaleStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum MaintenanceStatus {
  REQUESTED
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum CommissionStatus {
  PENDING
  PAID
}

enum FeeStatus {
  PENDING
  PAID
  OVERDUE
}

enum ApprovalStatus {
  OPEN
  AWAITING_APPROVAL
  APPROVED
  REJECTED
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  CHEQUE
  CARD
  OTHER
}

enum RentScheduleStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum AssetStatus {
  IN_USE
  STORED
  DISPOSED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(STAFF)
  // Set only for TENANT users: which lease this login can view/act on.
  leaseId      String?
  createdAt    DateTime @default(now())

  lease Lease? @relation(fields: [leaseId], references: [id], onDelete: SetNull)

  createdMaintenanceVisits MaintenanceVisit[]
  createdInvoices          Invoice[]
  createdInvoicePayments   InvoicePayment[]
  uploadedAttachments      Attachment[]

  @@index([leaseId])
}

model Property {
  id            String         @id @default(cuid())
  name          String
  addressLine   String
  city          String
  country       String
  // US state + ZIP, needed to look up live comps via RentCast (US-only coverage).
  state         String?
  postalCode    String?
  propertyType  PropertyType   @default(HOUSE)
  status        PropertyStatus @default(OWNED)
  purchasePrice Float?
  purchaseDate  DateTime?
  currentValue  Float?
  currency      String         @default("USD")
  areaSqm       Float?
  // Manual overrides for the 5-year forecast. When null, the forecast falls
  // back to a CAGR computed from purchasePrice -> currentValue.
  appreciationRateOverride Float?
  rentGrowthRateOverride   Float?
  // Public vacancy listing (free alternative to paid syndication).
  isListed            Boolean @default(false)
  askingRent          Float?
  listingDescription  String?
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  leases             Lease[]
  taxes              Tax[]
  maintenanceVisits  MaintenanceVisit[]
  sales              Sale[]
  fees               Fee[]
  comparables        Comparable[]
  assets             Asset[]

  @@index([country])
  @@index([status])
}

model Comparable {
  id         String    @id @default(cuid())
  propertyId String
  addressLine String
  city        String
  country     String
  areaSqm     Float
  salePrice   Float?
  monthlyRent Float?
  currency    String    @default("USD")
  observedDate DateTime?
  source      String?
  notes       String?
  createdAt   DateTime  @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model Lease {
  id            String         @id @default(cuid())
  propertyId    String
  tenantName    String
  tenantContact String?
  startDate     DateTime
  endDate       DateTime
  rentAmount    Float
  currency      String         @default("USD")
  frequency     LeaseFrequency @default(MONTHLY)
  status        LeaseStatus    @default(ACTIVE)
  depositAmount Float?
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  property     Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  rentPayments RentPayment[]
  commissions  Commission[]
  tenantUsers  User[]
  rentSchedules RentSchedule[]

  @@index([propertyId])
  @@index([status])
}

model RentPayment {
  id        String        @id @default(cuid())
  leaseId   String
  dueDate   DateTime
  paidDate  DateTime?
  amount    Float
  currency  String        @default("USD")
  status    PaymentStatus @default(PENDING)
  createdAt DateTime      @default(now())
  // Optional link to a generated installment, so a rent schedule's plan can
  // be reconciled against actual payments (including partial ones).
  installmentId String?

  lease       Lease        @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  installment Installment? @relation(fields: [installmentId], references: [id], onDelete: SetNull)

  @@index([leaseId])
  @@index([status])
  @@index([installmentId])
}

model RentSchedule {
  id               String             @id @default(cuid())
  referenceNo      String             @unique
  leaseId          String
  totalRent        Float
  frequency        LeaseFrequency
  installmentCount Int
  firstDueDate     DateTime
  status           RentScheduleStatus @default(ACTIVE)
  notes            String?
  createdAt        DateTime           @default(now())

  lease        Lease         @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  installments Installment[]

  @@index([leaseId])
}

model Installment {
  id             String   @id @default(cuid())
  rentScheduleId String
  sequence       Int
  dueDate        DateTime
  amount         Float
  createdAt      DateTime @default(now())

  rentSchedule RentSchedule  @relation(fields: [rentScheduleId], references: [id], onDelete: Cascade)
  rentPayments RentPayment[]

  @@index([rentScheduleId])
}

model Tax {
  id         String    @id @default(cuid())
  propertyId String
  taxType    String
  country    String
  taxYear    Int
  amount     Float
  currency   String    @default("USD")
  dueDate    DateTime
  paidDate   DateTime?
  status     TaxStatus @default(PENDING)
  createdAt  DateTime  @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([status])
}

model Sale {
  id           String     @id @default(cuid())
  propertyId   String
  saleDate     DateTime
  salePrice    Float
  currency     String     @default("USD")
  buyerName    String
  buyerContact String?
  brokerId     String?
  status       SaleStatus @default(PENDING)
  createdAt    DateTime   @default(now())

  property    Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  broker      Broker?      @relation(fields: [brokerId], references: [id])
  commissions Commission[]

  @@index([propertyId])
  @@index([brokerId])
}

model MaintenanceVisit {
  id          String            @id @default(cuid())
  // System-generated Expense & Order reference, e.g. WO-2026-0001. Null on
  // rows created before this field existed.
  referenceNo String?           @unique
  propertyId  String
  visitDate   DateTime
  // Free-text fallback for quick entries; prefer vendorId once the vendor
  // is on file (needed for 1099 aggregation).
  vendorName  String?
  vendorId    String?
  description String
  cost        Float?
  currency    String            @default("USD")
  status      MaintenanceStatus @default(SCHEDULED)
  // Financial approval state, separate from the operational status above.
  // An invoice can only be raised against an APPROVED expense/order.
  approvalStatus ApprovalStatus @default(APPROVED)
  createdById    String?
  createdAt   DateTime          @default(now())

  property  Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  vendor    Vendor?  @relation(fields: [vendorId], references: [id])
  createdBy User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  invoices  Invoice[]

  @@index([propertyId])
  @@index([status])
  @@index([vendorId])
}

model Vendor {
  id        String   @id @default(cuid())
  name      String
  contact   String?
  email     String?
  // Stored as plain text for the 1099 paperwork you'd fill in yourself.
  // Not encrypted - avoid putting a full SSN here, an EIN or masked ID is safer.
  taxId     String?
  country   String
  createdAt DateTime @default(now())

  maintenanceVisits MaintenanceVisit[]
  invoices          Invoice[]
}

model Employee {
  id         String   @id @default(cuid())
  name       String
  role       String
  country    String
  email      String?
  phone      String?
  salary     Float?
  currency   String   @default("USD")
  hireDate   DateTime?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model Broker {
  id                    String   @id @default(cuid())
  name                  String
  agencyName            String?
  contact               String?
  email                 String?
  defaultCommissionRate Float?
  country               String
  createdAt             DateTime @default(now())

  sales       Sale[]
  commissions Commission[]
}

model Commission {
  id        String            @id @default(cuid())
  brokerId  String
  saleId    String?
  leaseId   String?
  amount    Float
  currency  String            @default("USD")
  rate      Float?
  status    CommissionStatus  @default(PENDING)
  paidDate  DateTime?
  createdAt DateTime          @default(now())

  broker Broker @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  sale   Sale?  @relation(fields: [saleId], references: [id])
  lease  Lease? @relation(fields: [leaseId], references: [id])

  @@index([brokerId])
  @@index([saleId])
  @@index([leaseId])
}

model Fee {
  id         String    @id @default(cuid())
  propertyId String
  feeType    String
  amount     Float
  currency   String    @default("USD")
  dueDate    DateTime
  paidDate   DateTime?
  status     FeeStatus @default(PENDING)
  createdAt  DateTime  @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([status])
}

// Backs the system-generated reference numbers (WO-2026-0001, INV-2026-0001, ...):
// one row per prefix+year, incremented atomically on every allocation.
model Counter {
  id    String @id
  value Int    @default(0)
}

model Country {
  id              String   @id @default(cuid())
  name            String   @unique
  isoCode         String   @unique
  defaultCurrency String   @default("USD")
  taxRate         Float?
  timezone        String?
  createdAt       DateTime @default(now())
}

model Asset {
  id           String      @id @default(cuid())
  name         String
  category     String
  propertyId   String
  purchaseDate DateTime?
  value        Float?
  currency     String      @default("USD")
  status       AssetStatus @default(IN_USE)
  createdAt    DateTime    @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

// A supplier payable, always raised against an approved Expense & Order
// (MaintenanceVisit). Paid/outstanding status is computed from `payments`,
// never stored, so it can never drift from the actual settlement history.
model Invoice {
  id                    String   @id @default(cuid())
  referenceNo           String   @unique
  maintenanceVisitId    String
  vendorId              String
  supplierInvoiceNumber String?
  invoiceDate           DateTime
  dueDate               DateTime
  amount                Float
  currency              String   @default("USD")
  // Voided invoices stay in history but are excluded from payable balances.
  voided                Boolean  @default(false)
  createdById           String?
  createdAt             DateTime @default(now())

  maintenanceVisit MaintenanceVisit @relation(fields: [maintenanceVisitId], references: [id], onDelete: Cascade)
  vendor           Vendor           @relation(fields: [vendorId], references: [id])
  createdBy        User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  payments         InvoicePayment[]

  @@index([maintenanceVisitId])
  @@index([vendorId])
}

// One immutable row per settlement transaction against an invoice — never a
// free-text "paid amount" on the invoice header, so partial payments and
// audit evidence are always possible.
model InvoicePayment {
  id                String        @id @default(cuid())
  referenceNo       String        @unique
  invoiceId         String
  paymentDate       DateTime
  amount            Float
  method            PaymentMethod
  notes             String?
  // Method-specific evidence fields.
  bankName          String?
  transferReference String?
  chequeNumber      String?
  cashReceiptNumber String?
  receivedBy        String?
  createdById       String?
  createdAt         DateTime      @default(now())

  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  createdBy User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([invoiceId])
}

// Generic, reusable attachment store for any record in the system
// (leases, invoices, payments, expense & orders, vendors, ...).
model Attachment {
  id           String   @id @default(cuid())
  entityType   String
  entityId     String
  // Denormalized display label captured at upload time (e.g. property name,
  // invoice reference) so the central Documents list never needs a
  // polymorphic join back to every possible entity table.
  entityLabel  String
  fileName     String
  mimeType     String
  fileSize     Int
  storageKey   String
  description  String?
  uploadedById String?
  createdAt    DateTime @default(now())

  uploadedBy User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
}
